	<parameter name="memid" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     loan.`memberid` AS loan_memberid,
     loan.`loanid` AS loan_loanid,
     loan.`name` AS loan_name,
     loan.`address` AS loan_address,
     loan.`phoneno` AS loan_phoneno,
     loan.`nic` AS loan_nic,
     loan.`age` AS loan_age,
     loan.`amount` AS loan_amount,
     loan.`installments` AS loan_installments,
     loan.`mendaamount` AS loan_mendaamount,
     loan.`secamount` AS loan_secamount,
     loan.`date` AS loan_date,
     loan.`time` AS loan_time,
     guarantor.`memid` AS guarantor_memid,
     guarantor.`loanid` AS guarantor_loanid,
     guarantor.`fguarantorid` AS guarantor_fguarantorid,
     guarantor.`lguarantorid` AS guarantor_lguarantorid,
     guarantor.`fguarantorname` AS guarantor_fguarantorname,
     guarantor.`lguarantorname` AS guarantor_lguarantorname,
     guarantor.`fguarantoradd` AS guarantor_fguarantoradd,
     guarantor.`lguarantoradd` AS guarantor_lguarantoradd,
     guarantor.`fguarantornic` AS guarantor_fguarantornic,
     guarantor.`lguarantornic` AS guarantor_lguarantornic
FROM
     `loan` loan INNER JOIN `guarantor` guarantor ON loan.`memberid` = guarantor.`memid` WHERE loan.`memberid`=$P{memid}]]>
	</queryString>
