		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     loanpay.`memberid` AS loanpay_memberid,
     loanpay.`loanid` AS loanpay_loanid,
     loanpay.`name` AS loanpay_name,
     loanpay.`nicno` AS loanpay_nicno,
     loanpay.`paid_amount` AS loanpay_paid_amount,
     loanpay.`current_loan` AS loanpay_current_loan,
     loanpay.`date` AS loanpay_date,
     loanpay.`time` AS loanpay_time
FROM
     `loanpay` loanpay WHERE loanpay.`memberid`=$P{memid}]]>
	</queryString>
	<field name="loanpay_memberid" class="java.lang.Integer"/>
