	<parameter name="accno" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     deposit.`accno` AS deposit_accno,
     deposit.`name` AS deposit_name,
     deposit.`amount` AS deposit_amount,
     deposit.`balance` AS deposit_balance,
     deposit.`acc_type` AS deposit_acc_type,
     deposit.`date` AS deposit_date,
     deposit.`time` AS deposit_time
FROM
     `deposit` deposit WHERE deposit.`accno`=$P{accno}]]>
	</queryString>
