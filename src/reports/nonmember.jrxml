	<queryString>
		<![CDATA[SELECT
     nonmember.`nonmemid` AS nonmember_nonmemid,
     nonmember.`fname` AS nonmember_fname,
     nonmember.`lname` AS nonmember_lname,
     nonmember.`address` AS nonmember_address,
     nonmember.`dob` AS nonmember_dob,
     nonmember.`phoneno` AS nonmember_phoneno,
     nonmember.`employment` AS nonmember_employment,
     nonmember.`soname` AS nonmember_soname,
     nonmember.`soaddress` AS nonmember_soaddress,
     nonmember.`sonicno` AS nonmember_sonicno,
     nonmember.`relationship` AS nonmember_relationship,
     nonmember.`date` AS nonmember_date,
     nonmember.`time` AS nonmember_time
FROM
     `nonmember` nonmember WHERE nonmember.`nonmemid`=$P{nonid}]]>
	</queryString>
