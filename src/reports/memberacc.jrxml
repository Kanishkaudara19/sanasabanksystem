	<parameter name="accno" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     memberacc.`accno` AS memberacc_accno,
     memberacc.`memberid` AS memberacc_memberid,
     memberacc.`name` AS memberacc_name,
     memberacc.`balance` AS memberacc_balance,
     memberacc.`date` AS memberacc_date,
     memberacc.`time` AS memberacc_time
FROM
     `memberacc` memberacc WHERE memberacc.`accno`=$P{accno}]]>
	</queryString>
