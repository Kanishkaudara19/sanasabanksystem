	<queryString>
		<![CDATA[SELECT
     child.`childid` AS child_childid,
     child.`fname` AS child_fname,
     child.`lname` AS child_lname,
     child.`dob` AS child_dob,
     child.`address` AS child_address,
     child.`trusteename` AS child_trusteename,
     child.`trusteeaddress` AS child_trusteeaddress,
     child.`trusteenic` AS child_trusteenic,
     child.`trusteephoneno` AS child_trusteephoneno,
     child.`date` AS child_date,
     child.`time` AS child_time
FROM
     `child` child WHERE child.`childid`=$P{chid}]]>
	</queryString>
