	<parameter name="accno" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     withdraw.`accno` AS withdraw_accno,
     withdraw.`name` AS withdraw_name,
     withdraw.`amount` AS withdraw_amount,
     withdraw.`balance` AS withdraw_balance,
     withdraw.`acc_type` AS withdraw_acc_type,
     withdraw.`date` AS withdraw_date,
     withdraw.`time` AS withdraw_time
FROM
     `withdraw` withdraw WHERE withdraw.`accno`=$P{accno}]]>
	</queryString>
	<field name="withdraw_accno" class="java.lang.Integer"/>
	<field name="withdraw_name" class="java.lang.String"/>
