	<parameter name="accno" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     nonmemberacc.`accno` AS nonmemberacc_accno,
     nonmemberacc.`nonmemid` AS nonmemberacc_nonmemid,
     nonmemberacc.`name` AS nonmemberacc_name,
     nonmemberacc.`balance` AS nonmemberacc_balance,
     nonmemberacc.`date` AS nonmemberacc_date,
     nonmemberacc.`time` AS nonmemberacc_time
FROM
     `nonmemberacc` nonmemberacc WHERE nonmemberacc.`accno`=$P{accno}]]>
	</queryString>
