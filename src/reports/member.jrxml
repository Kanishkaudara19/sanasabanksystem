	<parameter name="memid" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     member.`memberid` AS member_memberid,
     member.`fname` AS member_fname,
     member.`lname` AS member_lname,
     member.`address` AS member_address,
     member.`employment` AS member_employment,
     member.`gender` AS member_gender,
     member.`dob` AS member_dob,
     member.`nicno` AS member_nicno,
     member.`phoneno` AS member_phoneno,
     member.`shares` AS member_shares,
     member.`date` AS member_date,
     member.`time` AS member_time
FROM
     `member` member WHERE  member.`memberid`=$P{memid}]]>
	</queryString>
