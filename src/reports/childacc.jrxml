	<parameter name="accno" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     childacc.`accno` AS childacc_accno,
     childacc.`childid` AS childacc_childid,
     childacc.`name` AS childacc_name,
     childacc.`balance` AS childacc_balance,
     childacc.`date` AS childacc_date,
     childacc.`time` AS childacc_time
FROM
     `childacc` childacc WHERE childacc.`accno`=$P{accno}]]>
	</queryString>
